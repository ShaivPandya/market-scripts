# Market Scripts Environment Variables
# Copy this file to .env and fill in your actual API keys

# FRED API Key (Federal Reserve Economic Data)
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# e-Stat API App ID (Statistics Bureau of Japan — used for Japan CPI)
# Register at: https://api.e-stat.go.jp/api/ → "API使用申込"
ESTAT_APP_ID=your_estat_app_id_here

# Destatis GENESIS API Key (German Federal Statistical Office)
# Get your key at: https://www-genesis.destatis.de → log in → "Webservice (API)"
GENESIS_API_KEY=your_genesis_api_key_here

# OpenAI API Key (used for document summarization)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Auth — single master account (no registration)
# To regenerate: python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt(12)).decode())"
AUTH_PASSWORD_HASH=your_bcrypt_hash_here
JWT_SECRET=your_random_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=12

# Auth mode: "password" (default) or "cloudflare" (bypass cookie auth; Cloudflare Access gates the app)
AUTH_MODE=password

# When set, /api/* (except /api/health) requires X-Api-Proxy-Secret to match.
# Intended to be injected by the Cloudflare Pages /api proxy function.
API_PROXY_SECRET=your_random_proxy_secret_here

# IBKR TWS / IB Gateway connection (for portfolio news)
# Only needed if you want IBKR news headlines alongside Google RSS.
IB_HOST=127.0.0.1
IB_PORT=4001
IB_CLIENT_ID=10

# Comma-separated tickers that should use strict Google RSS relevance filtering
# (quoted company aliases only; no bare ticker matching). Default is FLY.
NEWS_STRICT_TICKERS=FLY
