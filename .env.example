# Talisman Environment Variables
# Copy this file to .env and fill in your actual API keys

# FRED API Key (Federal Reserve Economic Data)
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# e-Stat API App ID (Statistics Bureau of Japan — used for Japan CPI)
# Register at: https://api.e-stat.go.jp/api/ → "API使用申込"
ESTAT_APP_ID=your_estat_app_id_here

# LLM provider selection. Defaults to "anthropic" when unset.
LLM_PROVIDER=anthropic

# Anthropic API Key (used when LLM_PROVIDER=anthropic)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (used when LLM_PROVIDER=openai)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key (used when LLM_PROVIDER=gemini)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides by tier.
ANTHROPIC_MODEL_LOW=claude-haiku-4-5
ANTHROPIC_MODEL_MID=claude-sonnet-4-6
ANTHROPIC_MODEL_HIGH=claude-opus-4-7
OPENAI_MODEL_LOW=gpt-5.4-mini
OPENAI_MODEL_MID=gpt-5.4
OPENAI_MODEL_HIGH=gpt-5.5
GEMINI_MODEL_LOW=gemini-3.1-flash-lite
GEMINI_MODEL_MID=gemini-3.1-pro-preview-customtools
GEMINI_MODEL_HIGH=gemini-3.1-pro-preview-customtools

# Auth — single master account (no registration)
# To regenerate: python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt(12)).decode())"
AUTH_PASSWORD_HASH=your_bcrypt_hash_here
JWT_SECRET=your_random_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=12
AUTH_LOGIN_RATE_LIMIT=5/minute
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_SECONDS=900

# Auth mode: "password" (default) or "cloudflare" (bypass cookie auth; Cloudflare Access gates the app).
# Cloudflare mode requires API_PROXY_SECRET to be set on the backend so direct API access fails closed.
AUTH_MODE=password

# API_PROXY_SECRET is enforced automatically in AUTH_MODE=cloudflare. In password mode,
# set REQUIRE_API_PROXY_SECRET=true only when an edge proxy injects X-Api-Proxy-Secret.
API_PROXY_SECRET=your_random_proxy_secret_here
REQUIRE_API_PROXY_SECRET=false

# Optional writable cache/storage paths (useful in containers)
# API_DISK_CACHE_DIR=/tmp/talisman/data_cache/api_cache
# API_GCS_CACHE_PREFIX=live/cache/api_cache
# PORTFOLIO_ANALYZER_ANCHOR_CACHE_PREFIX=live/cache/portfolio_analyzer_anchor
# ONTOLOGY_DB_PATH=/tmp/talisman/data_cache/ontology/ontology.sqlite3

# GCP production state
# Cloud SQL Unix socket URL shape:
# postgresql+psycopg://talisman_app:${DB_PASSWORD}@/talisman?host=/cloudsql/${INSTANCE_CONNECTION_NAME}
# psycopg direct URL shape for migration tools:
# postgresql://talisman_migrator:${DB_PASSWORD}@/talisman?host=/cloudsql/${INSTANCE_CONNECTION_NAME}
# DATABASE_URL=postgresql://talisman_app:${DB_PASSWORD}@/talisman?host=/cloudsql/${INSTANCE_CONNECTION_NAME}
# DATABASE_URL_MIGRATION=postgresql://talisman_migrator:${DB_PASSWORD}@/talisman?host=/cloudsql/${INSTANCE_CONNECTION_NAME}
# INSTANCE_CONNECTION_NAME=project-id:us-central1:talisman
# GCS_STATE_BUCKET=talisman-state-prod
# STATE_STORAGE_BACKEND=gcs
# ENVIRONMENT=production
# WRITE_FREEZE=false
# MIGRATION_RUN_ID=20260429T000000Z

# Durable async jobs (production)
# Production keeps durable status/results/progress in Postgres. Heavier jobs
# dispatch to the generic Cloud Run Job; cheap jobs such as sizer can run inline.
# ASYNC_JOB_BACKEND=cloud_run_jobs
# ASYNC_CLOUD_RUN_JOB=talisman-async-job
# ASYNC_DISPATCH_BACKEND_SIZER=inline
# ASYNC_QUEUE_ANALYZER=default
# ASYNC_QUEUE_HEDGING=default
# ASYNC_QUEUE_SIZER=sizer
# ASYNC_QUEUE_ONTOLOGY=default
# ASYNC_QUEUE_SCREENS=screens
# ASYNC_QUEUE_MAINTENANCE=default
# ASYNC_JOB_COMPLETED_TTL_SECONDS=86400
# ASYNC_ANALYZER_COMPLETED_TTL_SECONDS=86400
# ASYNC_JOB_FAILED_TTL_SECONDS=604800
# ASYNC_JOB_STALE_GRACE_SECONDS=300
# POSTGRES_POOL_ENABLED=true
# POSTGRES_POOL_MIN_SIZE=0
# POSTGRES_POOL_MAX_SIZE=4
# POSTGRES_POOL_TIMEOUT_SECONDS=5
# ASYNC_JOB_SUCCESS_READ_AUDIT_ENABLED=false
# ONTOLOGY_JOB_SUCCESS_READ_AUDIT_ENABLED=false
# AGENT_DELTA_FLUSH_INTERVAL_MS=500
# AGENT_DELTA_FLUSH_BYTES=1024
# ASYNC_MAINTENANCE_COMPLETED_TTL_SECONDS=3600
# SCHEDULER_SECRET=your_random_scheduler_secret_here
# REPORT_SYNC_SECRET=your_random_report_sync_secret_here
# TALISMAN_API_URL=https://your-api.example.com

EIA_API_KEY=your_eia_api_key_here
